# Lumen Health — Frontend environment variables template
# Copy to .env and fill in real values. Never commit .env.

# Backend API base URL (no trailing slash)
# • Production : https://your-app.onrender.com
# • Android emulator dev : http://10.0.2.2:8000
# • iOS simulator dev    : http://localhost:8000
# • Physical device dev  : http://<YOUR_LAN_IP>:8000
EXPO_PUBLIC_API_URL=https://your-app.onrender.com
